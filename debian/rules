#!/usr/bin/make -f

export DEB_LDFLAGS_MAINT_APPEND=-Wl,-O1 -Wl,-z,defs
export DEB_BUILD_MAINT_OPTIONS=hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		--enable-colord \
		--enable-libnotify \
		--enable-libxklavier \
		--enable-pluggable-dialogs \
		--enable-sound-settings \
		--enable-xcursor \
		--with-helper-path-prefix=/usr/share

execute_after_dh_auto_install:
	install -D -m 644 debian/90xfce-global-scale debian/tmp/etc/X11/Xsession.d/90xfce-global-scale
	# Debianise helpers
	sed -i -e 's/^WebBrowser=.*/WebBrowser=debian-sensible-browser/' \
		-e 's/TerminalEmulator=.*/TerminalEmulator=debian-x-terminal-emulator/' \
		debian/tmp/etc/xdg/xfce4/helpers.rc

	## Create a muttng/neomutt helper from the mutt one
	sed -e 's/utt/uttng/;s/Icon=muttng/Icon=mutt/' \
		<debian/tmp/usr/share/xfce4/helpers/mutt.desktop \
		>debian/tmp/usr/share/xfce4/helpers/muttng.desktop
	sed -e 's/mutt/neomutt/;s/Icon=neomutt/Icon=mutt/' \
		<debian/tmp/usr/share/xfce4/helpers/mutt.desktop \
		>debian/tmp/usr/share/xfce4/helpers/neomutt.desktop

	find debian/tmp -name '*.la' -delete

override_dh_installchangelogs:
	DEB_BUILD_OPTIONS=notrimdch dh_installchangelogs NEWS

override_dh_installman:
	dh_installman debian/*.1

override_dh_auto_test:
	dh_auto_test
	$(CC) $(CPPFLAGS) $(CFLAGS) -I. $$(pkg-config --cflags glib-2.0) debian/tests/global-scale-policy.c -o debian/global-scale-policy $$(pkg-config --libs glib-2.0) -lm
	debian/global-scale-policy
	$(CC) $(CPPFLAGS) $(CFLAGS) -DHAVE_CONFIG_H -ffunction-sections -fdata-sections -I. $$(pkg-config --cflags gtk+-3.0 libxfce4ui-2 libxfce4util-1.0 libxfconf-0 xrandr) debian/tests/global-scale-transactions.c common/.libs/libxfce4-settings.a -o debian/global-scale-transactions -Wl,--gc-sections $$(pkg-config --libs gtk+-3.0 libxfce4ui-2 libxfce4util-1.0 libxfconf-0 xrandr) -lX11 -lXext -lm
	debian/global-scale-transactions

# Optional real-X11 gate. Xvfb is a development test dependency, not a runtime
# or release build requirement. Invoke explicitly in the persistent container.
.PHONY: check-global-scale-x11
check-global-scale-x11:
	$(CC) $(CPPFLAGS) $(CFLAGS) -DHAVE_CONFIG_H -I. $$(pkg-config --cflags gtk+-3.0 libxfconf-0) debian/tests/global-scale-generations.c common/.libs/libxfce4-settings.a -o debian/global-scale-generations $$(pkg-config --libs gtk+-3.0 libxfce4util-1.0 libxfconf-0 xrandr) -lX11 -lm
	NO_AT_BRIDGE=1 XDG_RUNTIME_DIR=$$(mktemp -d "$${TMPDIR:-/tmp}/xfce-scale-run.XXXXXX") XDG_CONFIG_HOME=$$(mktemp -d "$${TMPDIR:-/tmp}/xfce-scale-config.XXXXXX") dbus-run-session -- xvfb-run -a -s '-screen 0 1920x1080x24' debian/global-scale-generations
