machine minios {
    cpus: 2
    ram: 8Gb
    iso: { source: "${ISO}" }
    disk main: { size: 8Gb }
    disk payload: { source: "${PAYLOAD}" }
    # QXL is the baseline. Virtio is a supplementary driver-capability run:
    # this ISO's modesetting+QXL crashes in qxl_image_init on a transform,
    # while its QXL DDX rejects transforms with BadValue.
    video main: { adapter_type: "${VIDEO_ADAPTER}" }
}

test hidpi_live {
    minios {
        start
        wait "Start MiniOS" timeout 30s
        press Enter
        wait "Toolbox" timeout 5m
        press LeftCtrl+LeftAlt+t
        wait "live@" timeout 30s
        press F11
        type "sudo mkdir -p /mnt/hidpi && sudo mount $(sudo blkid -L HIDPITEST) /mnt/hidpi && sudo chmod 777 /mnt/hidpi && sudo apt-get install -y /mnt/hidpi/*.deb; RC=$?; printf 'HIDPI_INSTALL_%s_%s\\n' RC $RC" interval 80ms
        press Enter
        wait "HIDPI_INSTALL_RC_0" timeout 2m
        type "sudo systemctl restart lightdm"
        press Enter
        sleep 15s
        wait "Toolbox" timeout 2m
        press LeftCtrl+LeftAlt+t
        wait "live@" timeout 30s
        press F11
        type "XFSETTINGSD_DEBUG=displays xfsettingsd --replace --no-daemon >/tmp/hidpi-xfsettingsd.log 2>&1 & xfwm4 --replace >/tmp/hidpi-xfwm4.log 2>&1 &" interval 80ms
        press Enter
        sleep 3s
        type "xfconf-query -c xfwm4 -p /general/use_compositing -s ${COMPOSITING}"
        press Enter
        sleep 2s
        type "python3 -u /mnt/hidpi/live-scale.py >/mnt/hidpi/live.log 2>&1; RC=$?; sync; printf 'HIDPI_LIVE_%s_%s\\n' RC $RC"
        press Enter
        wait "HIDPI_LIVE_RC_0" timeout 2m
        screenshot "${SCREENSHOT}"
        press F11
        type "xfce4-display-settings &"
        press Enter
        wait "Interface scale" timeout 30s
        wait "Apply" timeout 30s
        screenshot "${GUI_SCREENSHOT}"
    }
}

test hidpi_gui: hidpi_live {
    minios {
        wait "Interface scale" timeout 30s
        mouse click "Automatic".from_top(0)
        press Home
        press Down
        press Down
        press Enter
        mouse click "Apply".from_top(0)
        # Confirm before the ten-second countdown; OCR processing itself can
        # consume most of that interval on a software-rendered guest.
        sleep 1s
        press Enter
        wait "Interface scale" timeout 15s
        screenshot "${GUI_SCREENSHOT}.125.png"
        press LeftAlt+F4
        press LeftCtrl+LeftAlt+t
        wait "live@" timeout 30s
        type "test $(xfconf-query -c displays -p /GlobalScale) = 125; RC=$?; printf 'HIDPI_GUI_%s_%s\\n' RC $RC"
        press Enter
        wait "HIDPI_GUI_RC_0" timeout 10s
        type "firefox file:///mnt/hidpi/browser-scale.html &"
        press Enter
        wait "HiDPI browser probe" timeout 1m
        wait "Browser DPR: 2" timeout 30s
        screenshot "${GUI_SCREENSHOT}.browser.png"
        press F11
        sleep 2s
        wait "Browser DPR: 2" timeout 15s
        screenshot "${GUI_SCREENSHOT}.fullscreen.png"
        press F11
        press LeftCtrl+LeftAlt+t
        wait "live@" timeout 30s
        type "thunar & sleep 1; /mnt/hidpi/qt5-scale-probe --stay & /mnt/hidpi/qt6-scale-probe --stay & /mnt/hidpi/gtk4-scale-probe --stay &"
        press Enter
        wait "HiDPI Qt5 probe" timeout 30s
        wait "HiDPI Qt6 probe" timeout 30s
        wait "HiDPI GTK4 probe" timeout 30s
        screenshot "${GUI_SCREENSHOT}.toolkits.png"
    }
}

# Separate branch: the baseline is Automatic/100% from hidpi_live. Exercise
# the frontend's shared Apply, not the backend Request property directly.
test hidpi_apply: hidpi_live {
    minios {
        press LeftAlt+F4
        press LeftCtrl+LeftAlt+t
        wait "live@" timeout 30s
        type "python3 /mnt/hidpi/transaction-state.py capture >/mnt/hidpi/transaction-baseline.json; RC=$?; printf 'HIDPI_BASELINE_%s_%s\\n' RC $RC"
        press Enter
        wait "HIDPI_BASELINE_RC_0" timeout 20s
        type "xfce4-display-settings &"
        press Enter
        wait "Interface scale" timeout 30s
        mouse click "Automatic".from_top(0)
        press Home
        press Down
        press Down
        press Enter
        mouse click "Apply".from_top(0)
        sleep 1s
        press Esc
        sleep 2s
        press LeftAlt+F4
        press LeftCtrl+LeftAlt+t
        wait "live@" timeout 30s
        type "python3 /mnt/hidpi/transaction-state.py restored >/mnt/hidpi/scale-cancel.json; RC=$?; printf 'HIDPI_CANCEL_%s_%s\\n' RC $RC"
        press Enter
        wait "HIDPI_CANCEL_RC_0" timeout 20s
        type "xfce4-display-settings &"
        press Enter
        wait "Interface scale" timeout 30s
        mouse click "1280x800".from_top(0)
        press End
        mouse click "1280x960".from_top(0)
        mouse click "Automatic".from_top(0)
        press Home
        press Down
        press Down
        press Enter
        mouse click "Apply".from_top(0)
        sleep 1s
        press Enter
        sleep 2s
        press LeftAlt+F4
        press LeftCtrl+LeftAlt+t
        wait "live@" timeout 30s
        type "python3 /mnt/hidpi/transaction-state.py kept >/mnt/hidpi/combined-confirm.json; RC=$?; printf 'HIDPI_COMBINED_%s_%s\\n' RC $RC"
        press Enter
        wait "HIDPI_COMBINED_RC_0" timeout 20s
        type "xfce4-display-settings &"
        press Enter
        wait "Interface scale" timeout 30s
        mouse move "Close".from_top(0)
        mouse click "1280x960".from_top(0)
        press End
        mouse click "1600x1200".from_top(0)
        press LeftAlt+s
        press Space
        press Home
        press Down
        press Enter
        mouse click "Apply".from_top(0)
        # Let the single frontend confirmation expire; both settings must revert.
        sleep 17s
        screenshot "${GUI_SCREENSHOT}.combined-timeout.png"
        press LeftAlt+F4
        press LeftCtrl+LeftAlt+t
        wait "live@" timeout 30s
        type "python3 /mnt/hidpi/transaction-state.py kept >/mnt/hidpi/combined-timeout.json; RC=$?; sync; printf 'HIDPI_ROLLBACK_%s_%s\\n' RC $RC"
        press Enter
        wait "HIDPI_ROLLBACK_RC_0" timeout 20s
        type "xfce4-display-settings &"
        press Enter
        wait "Interface scale" timeout 30s
        mouse move "Close".from_top(0)
        mouse click "1280x960".from_top(0)
        press End
        mouse click "1600x1200".from_top(0)
        press LeftAlt+s
        press Space
        press Home
        press Down
        press Down
        press Down
        press Enter
        mouse click "Apply".from_top(0)
        sleep 1s
        press Esc
        sleep 2s
        press LeftAlt+F4
        press LeftCtrl+LeftAlt+t
        wait "live@" timeout 30s
        type "python3 /mnt/hidpi/transaction-state.py kept >/mnt/hidpi/combined-cancel.json; RC=$?; sync; printf 'HIDPI_RESTORE_%s_%s\\n' RC $RC"
        press Enter
        wait "HIDPI_RESTORE_RC_0" timeout 20s
    }
}

test hidpi_pointer: hidpi_live {
    minios {
        mouse move "Automatic".from_top(0)
        screenshot "${GUI_SCREENSHOT}.pointer.png"
        press LeftCtrl+LeftAlt+t
        wait "live@" timeout 30s
        type "python3 -c 'import gi; gi.require_version(\"Gdk\", \"3.0\"); from gi.repository import Gdk; Gdk.init([]); print(Gdk.Display.get_default().get_default_seat().get_pointer().get_position()[1:])' >/mnt/hidpi/pointer.log; RC=$?; sync; printf 'HIDPI_POINTER_%s_%s\\n' RC $RC" interval 80ms
        press Enter
        wait "HIDPI_POINTER_RC_0" timeout 10s
    }
}

test hidpi_relogin: hidpi_gui {
    minios {
        press LeftCtrl+LeftAlt+t
        wait "live@" timeout 30s
        type "python3 /mnt/hidpi/check-state.py 125 >/mnt/hidpi/before-login.json; RC=$?; printf 'HIDPI_BEFORE_%s_%s\\n' RC $RC" interval 80ms
        press Enter
        wait "HIDPI_BEFORE_RC_0" timeout 20s
        type "sudo systemctl restart lightdm"
        press Enter
        sleep 15s
        wait "Toolbox" timeout 2m
        press LeftCtrl+LeftAlt+t
        wait "live@" timeout 30s
        type "python3 /mnt/hidpi/check-state.py 125 >/mnt/hidpi/after-login.json; RC=$?; sync; printf 'HIDPI_RELOGIN_%s_%s\\n' RC $RC" interval 80ms
        press Enter
        wait "HIDPI_RELOGIN_RC_0" timeout 30s
        screenshot "${GUI_SCREENSHOT}.relogin.png"
    }
}
