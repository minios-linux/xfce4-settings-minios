From: Debian Xfce Maintainers <debian-xfce@lists.debian.org>
Subject: Fix gmodule-2.0 linking

Forwarded: not-needed
---

--- a/xfsettingsd/Makefile.am
+++ b/xfsettingsd/Makefile.am
@@ -137,6 +137,7 @@ libxfsettingsd_gtk_settings_sync_la_LDFL
 	-module \
 	-no-undefined \
 	-export-symbols-regex '^(g_module_check|gtk_module)_init' \
+	-lgmodule-2.0 \
 	$(PLATFORM_LDFLAGS)
 
 libxfsettingsd_gtk_settings_sync_la_LIBADD = \
--- a/xfsettingsd/Makefile.in
+++ b/xfsettingsd/Makefile.in
@@ -603,6 +603,7 @@ libxfsettingsd_gtk_settings_sync_la_LDFL
 	-module \
 	-no-undefined \
 	-export-symbols-regex '^(g_module_check|gtk_module)_init' \
+	-lgmodule-2.0 \
 	$(PLATFORM_LDFLAGS)
 
 libxfsettingsd_gtk_settings_sync_la_LIBADD = \
